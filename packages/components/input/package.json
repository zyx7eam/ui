{
    "name": "@zyxui/input",
    "version": "0.0.1",
    "description": "Input component for @zyxui",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "sideEffects": false,
    "license": "MIT",
    "files": [
        "dist/**"
    ],
    "scripts": {
        "build": "tsup src --dts",
        "dev": "tsup src --watch",
        "lint": "eslint src/",
        "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
        "typecheck": "tsc --noEmit",
        "build:fast": "tsup src"
    },
    "devDependencies": {
        "@zyxui/tsconfig": "workspace:*",
        "@types/node": "^20.11.24",
        "@types/react": "^18.2.61",
        "@types/react-dom": "^18.2.19",
        "clean-package": "2.2.0",
        "eslint": "^8.57.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "typescript": "^5.3.3"
    },
    "dependencies": {
        "@react-aria/textfield": "^3.14.3",
        "@react-aria/utils": "^3.24.1",
        "@zyxui/lib": "workspace:*",
        "@zyxui/theme": "workspace:*",
        "class-variance-authority": "^0.7.0",
        "tsup": "^7.3.0"
    },
    "peerDependencies": {
        "react": ">=16"
    },
    "publishConfig": {
        "access": "public"
    }
}
